# Postgres (required)
DATABASE_URL="postgresql://budu:budu@localhost:5436/budu?schema=public"

# Google OAuth (required for sign-in)
AUTH_SECRET="generate-a-long-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Klapi-compatible names are also accepted by Budu.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: restrict Google sign-in to an organization. This is enforced, not merely a Google UI hint.
GOOGLE_WORKSPACE_DOMAIN=""

# Kitsas is deliberately read-only.
#
# There are two separate Kitsas hosts and they are not interchangeable:
#   - KitsasHub (below, KITSAS_HUB_*) is the documented API at api.kitsas.fi.
#     It serves login, books, accounts, dimensions and fiscal years.
#   - The legacy per-book cloud backend (KITSAS_API_URL) serves the voucher
#     reads. The Hub documents no voucher read endpoint, so realized expenses
#     come from here. Kitsas confirmed the legacy API is alive and usable.
#
# Budu resolves the cloud URL and token at runtime from the compatibility login
# (POST {hub}/login returns clouds[], each with id (cloudid), url and token)
# using the KITSAS_HUB_USERNAME/PASSWORD below. Set KITSAS_CLOUD_ID to pick a
# specific book when the user has several; otherwise the first active cloud is
# used. KITSAS_API_URL/KITSAS_TOKEN are an optional manual override that skips
# the login entirely.
KITSAS_CLOUD_ID=""
KITSAS_API_URL=""
KITSAS_TOKEN=""
# /tositteet is GET-only and lists vouchers. Verified against both the test
# server and the live book: the list carries id, pvm, otsikko and summa, and
# GET /tositteet/{id} carries the per-account viennit the sync reads.
KITSAS_EXPENSES_PATH="/tositteet"

# KitsasHub discovery API. Only used by GET /api/kitsas/discover to retrieve
# the book/account catalogue for budget account mapping.
# Use the test server during development. A test account can be created there
# freely; Kitsas does not guarantee that test data is retained.
KITSAS_HUB_URL="https://test-api.kitsas.fi"
KITSAS_HUB_USERNAME=""
KITSAS_HUB_PASSWORD=""
KITSAS_HUB_BOOK_ID=""

# Required by GET /api/cron/kitsas. Rotating it needs a fresh build, not a
# redeploy: the function compares against the value baked in at build time.
CRON_SECRET=""

# Comma-separated emails that may open /admin. Left blank, every account that
# passes GOOGLE_WORKSPACE_DOMAIN is an admin.
BUDU_ADMIN_EMAILS=""

# Local development only: adds a password-less sign-in to /login so the dashboard
# can be opened without Google OAuth. Ignored entirely unless NODE_ENV is not
# "production", which `next build` fixes, so a deploy cannot enable it. Pairs
# with scripts/seed-local.mjs, which writes the user it signs in as.
BUDU_DEV_LOGIN=""
BUDU_SEED_EMAIL=""
