generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  budgets   Budget[]
}

model Budget {
  id        String       @id @default(cuid())
  name      String
  currency  String       @default("EUR")
  startsOn  DateTime?    @db.Date
  endsOn    DateTime?    @db.Date
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  createdBy User         @relation(fields: [createdById], references: [id])
  createdById String
  lines     BudgetLine[]
  syncRuns  SyncRun[]
  voucherStates KitsasVoucherState[]
  unmappedAccounts KitsasUnmappedAccount[]
}

model BudgetLine {
  id          String   @id @default(cuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    String
  description String?
  /// Section heading the row sat under in the imported budget, e.g. "Kone- ja kalustokulut".
  groupName   String?
  plannedCents Int
  kitsasAccount Int?
  kind        String   @default("EXPENSE")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([budgetId, category])
}

/// One row per Kitsas voucher entry (vienti), stored as it was booked rather
/// than as a budget happens to interpret it.
///
/// Both sides are kept because which one counts is a property of the budget
/// line, not of the booking: an expense line reads `debetCents`, an income line
/// `kreditCents`. Deriving that at read time is what lets a line be reclassified
/// between meno and tulo without refetching anything — the earlier shape stored
/// one side chosen at sync time, so a reclassification silently left figures
/// taken from the wrong column. A single net amount would not do either: on an
/// entry carrying both sides it cannot be told apart from no entry at all.
///
/// Not scoped to a budget. Every budget reads the same book, so a voucher entry
/// is a fact about the book; budgets join to it by account number at read time.
/// This is also what lets a budget line be added for an account later and show
/// its history immediately, with no sync in between.
model KitsasEntry {
  voucherId   Int
  entryId     Int
  occurredOn  DateTime @db.Date
  account     Int
  description String
  debetCents  Int      @default(0)
  kreditCents Int      @default(0)
  /// Attachment references as `{ attachments: [{ id, name, type }] }`. The bytes
  /// stay in Kitsas and are served through an authenticated proxy.
  rawPayload  Json?
  syncedAt    DateTime @updatedAt

  @@id([voucherId, entryId])
  @@index([account, occurredOn])
  @@index([occurredOn])
}

model SyncRun {
  id          String   @id @default(cuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  source      String
  status      String
  imported    Int      @default(0)
  detail      String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

/// One row per Kitsas voucher seen by a sync, mapped to a budget line or not.
/// The signature lets an incremental sync skip unchanged vouchers: Kitsas has no
/// modified-since filter, so the cheap list endpoint is diffed against this
/// instead of re-fetching every voucher's detail on each run.
model KitsasVoucherState {
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  voucherId Int
  signature String
  syncedAt  DateTime @updatedAt

  @@id([budgetId, voucherId])
}

/// Accounts a sync found carrying money that no budget line maps, so the figures
/// were read from Kitsas and then dropped.
///
/// This exists because the sync's account filter is silent by design: it stores
/// only entries on accounts some line maps and discards the rest without trace.
/// A talousarvio written against a different chart of accounts therefore yields
/// a dashboard that is quietly, confidently wrong — every sync reports success
/// while six figures of real activity are simply absent from the page.
///
/// Scoped to a budget, because being unmapped is a fact about one budget's
/// mapping over its own period rather than about the book. Replaced wholesale on
/// each sync, so it can never describe a mapping that has since been corrected.
model KitsasUnmappedAccount {
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account     Int
  /// The account's name in Kitsas, so the list reads without the tililuettelo open.
  name        String
  entries     Int      @default(0)
  debetCents  Int      @default(0)
  kreditCents Int      @default(0)
  syncedAt    DateTime @updatedAt

  @@id([budgetId, account])
}
